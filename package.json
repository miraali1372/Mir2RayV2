{
  "name": "mir2rayv2",
  "private": true,
  "version": "1.0.6",
  "description": "Portable Mir2rayV2 client for Android and Windows",
  "author": "Mir2rayV2",
  "main": "desktop/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','server.js']) fs.rmSync(p,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "build:android": "npm run build && npx cap sync android",
    "android:libs": "powershell -ExecutionPolicy Bypass -File scripts/download-android-libs.ps1",
    "desktop:runtime": "powershell -ExecutionPolicy Bypass -File scripts/download-windows-runtime.ps1",
    "desktop:electron": "powershell -ExecutionPolicy Bypass -File scripts/install-electron-runtime.ps1",
    "desktop:run": "npm run build && electron .",
    "test:desktop": "node --test desktop/tests/*.test.mjs && tsx --test src/utils/profileQuality.test.ts",
    "build:windows:portable": "npm run lint && npm run test:desktop && npm run build && npm run desktop:electron && npm run desktop:runtime && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.42.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-virtuoso": "^4.18.11",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.11.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.mir2ray.windows",
    "productName": "Mir2rayV2",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release-output/windows"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "!desktop/runtime/**/*",
      "!desktop/tests/**/*",
      "!node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["portable"],
      "icon": "output/imagegen/mir2rayv2-icon-transparent.png",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Mir2rayV2-${version}-Windows-Portable.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": true,
      "artifactName": "Mir2rayV2-${version}-Windows-Portable.${ext}"
    }
  }
}
